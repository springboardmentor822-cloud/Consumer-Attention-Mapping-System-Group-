# Production Environment Variables

# Database
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=prod_secure_password_123
POSTGRES_DB=consumer_attention_prod

# Security
SECRET_KEY=generate_a_secure_random_string_here_for_production
