{
  "info": {
    "name": "Consumer Attention Mapping System - Backend",
    "description": "Milestone 1: Auth (JWT + RBAC), Store CRUD, Shelf CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "manager_token", "value": "" },
    { "key": "analyst_token", "value": "" },
    { "key": "store_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register - Manager",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@test.com\",\n  \"password\": \"testpass123\",\n  \"role_name\": \"StoreManager\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('manager_token', pm.response.json().access_token);",
                  "}",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - Analyst",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"analyst@test.com\",\n  \"password\": \"testpass123\",\n  \"role_name\": \"Analyst\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('analyst_token', pm.response.json().access_token);",
                  "}",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Manager (OAuth2 form)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "manager@test.com" },
                { "key": "password", "value": "testpass123" }
              ]
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] },
            "description": "Uses OAuth2PasswordRequestForm - fields are 'username' and 'password', NOT JSON, unlike /register."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('manager_token', pm.response.json().access_token);",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Analyst (OAuth2 form)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "analyst@test.com" },
                { "key": "password", "value": "testpass123" }
              ]
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('analyst_token', pm.response.json().access_token);",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Stores",
      "item": [
        {
          "name": "Create Store (Manager - expect 201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{manager_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Flagship Store\",\n  \"location\": \"Indore\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/stores", "host": ["{{base_url}}"], "path": ["api", "stores"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('store_id', pm.response.json().id);",
                  "}",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Store (Analyst - expect 403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{analyst_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Should Be Blocked\",\n  \"location\": \"Nowhere\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/stores", "host": ["{{base_url}}"], "path": ["api", "stores"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403 (role enforcement)', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Stores",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{manager_token}}" }],
            "url": { "raw": "{{base_url}}/api/stores", "host": ["{{base_url}}"], "path": ["api", "stores"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        }
      ]
    },
    {
      "name": "Shelves",
      "item": [
        {
          "name": "Create Shelf (Manager - expect 201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{manager_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shelf_name\": \"Aisle 3\",\n  \"zone_coordinates\": [[0, 0], [10, 10]]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/stores/{{store_id}}/shelves",
              "host": ["{{base_url}}"],
              "path": ["api", "stores", "{{store_id}}", "shelves"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 201', () => pm.response.to.have.status(201));"] }
            }
          ]
        },
        {
          "name": "List Shelves for Store",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{manager_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/stores/{{store_id}}/shelves",
              "host": ["{{base_url}}"],
              "path": ["api", "stores", "{{store_id}}", "shelves"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "Create Shelf - Store Not Found (expect 404)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{manager_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shelf_name\": \"Ghost Aisle\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/stores/00000000-0000-0000-0000-000000000000/shelves",
              "host": ["{{base_url}}"],
              "path": ["api", "stores", "00000000-0000-0000-0000-000000000000", "shelves"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 404', () => pm.response.to.have.status(404));"] }
            }
          ]
        }
      ]
    }
  ]
}
