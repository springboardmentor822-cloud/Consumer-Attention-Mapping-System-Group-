# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# ---------------------------------------------------------------
# Environment / secrets
# Never commit real credentials. backend/.env.example is the
# checked-in template - the negation below keeps it tracked.
# ---------------------------------------------------------------
.env
.env.*
!.env.example
!backend/.env.example

# ---------------------------------------------------------------
# Editors
# ---------------------------------------------------------------
.vscode/
.idea/

# ---------------------------------------------------------------
# Node / frontend build output
# ---------------------------------------------------------------
node_modules/
dist/
build/

# ---------------------------------------------------------------
# ML datasets, training runs, and model weights
# These are large binaries that must be fetched/trained separately,
# not stored in git (they previously bloated this repo to ~66 GB).
# ---------------------------------------------------------------
datasets/
runs/
training/
weights/
backend/Ultralytics/
*.pt
*.pth
*.onnx
backend/mobileclip2_b.ts

# ---------------------------------------------------------------
# Runtime uploads and generated media
# Source videos and annotated frames produced by the detection
# pipeline - regenerated by processing a video, never source.
# ---------------------------------------------------------------
backend/uploads/
*.mp4
*.avi
*.mov
*.mkv
*.webm
# Exception: the project demo recording is versioned through Git LFS (see
# .gitattributes) so it can live on GitHub despite the 100 MB per-file limit.
# Only this directory is exempt - working footage still belongs in
# backend/uploads/videos/ and stays out of git.
!media/*.mp4

# ---------------------------------------------------------------
# Logs
# ---------------------------------------------------------------
*.log
