						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "username",
									"value": "manager_test@example.com",
									"type": "text"
								},
								{
									"key": "password",
									"value": "SecurePassword123!",
									"type": "text"
								}
