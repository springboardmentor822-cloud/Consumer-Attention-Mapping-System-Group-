# Copy this file to .env for Docker Compose. Do not commit real secrets.
POSTGRES_USER=retail_admin
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=attention_mapping_db
POSTGRES_PORT=5432
REDIS_PORT=6379

# Set true before `docker compose build backend` if the API container must run
# CPU YOLO training/inference jobs. The default keeps the service image lean.
INSTALL_ML=false

# Backend settings. The localhost URLs are also suitable when the API is run
# directly on the host and only Redis/TimescaleDB run in Docker.
DATABASE_URL=postgresql://retail_admin:change-me-for-local-development@localhost:5432/attention_mapping_db
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_KEY=attention:tracking
REDIS_CONSUMER_GROUP=attention-api
TRACKING_BATCH_SIZE=100
TRACKING_FLUSH_SECONDS=2.0
ALLOW_MEMORY_STREAM_FALLBACK=true
MODEL_ARTIFACT_DIR=artifacts/models

PROJECT_NAME=Consumer Attention Mapping API
SECRET_KEY=replace-this-with-a-long-random-value
ACCESS_TOKEN_MINUTES=240
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
