# Project Configurations
PROJECT_NAME="Consumer Attention Mapping System"
DEBUG=false
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS="*"

# Postgres Database connection
DATABASE_URL="postgresql://attention_user:attention_secure_pwd@localhost:5432/attention_db"

# MongoDB connection url
MONGO_URL="mongodb://localhost:27017/attention_analytics"

# Redis cache and streams connection url
REDIS_URL="redis://localhost:6379/0"

# JWT configuration secrets
JWT_SECRET="super_secret_attention_key_12345!"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Feature Flags
ENABLE_GAZE=true
ENABLE_RECOMMENDATIONS=true
ENABLE_NOTIFICATIONS=true

# Frontend Configuration
VITE_API_URL="http://localhost:8000"
