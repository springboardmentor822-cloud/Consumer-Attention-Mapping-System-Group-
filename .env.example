DATABASE_URL=postgresql://camsystem:camsystem@postgres:5432/camsystem
TIMESCALE_DATABASE_URL=postgresql://camsystem:camsystem@timescaledb:5432/camsystem_timeseries
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
DEV_PASSWORD_RESET=false
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Real POS/webhook integration - a machine-to-machine credential for
# POST /api/v1/completion/pos/purchases, separate from human user JWTs.
# Leave blank to require a StoreManager/SuperAdmin JWT for this endpoint
# instead (e.g. for manual testing). Set to a long random value to let a
# real POS system call it directly with no user account involved.
POS_WEBHOOK_API_KEY=
