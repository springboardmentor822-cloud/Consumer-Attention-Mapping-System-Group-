# -------------------------------------------------------------
# CONSUMER ATTENTION MAPPING SYSTEM - ENVIRONMENT VARIABLES
# -------------------------------------------------------------

# Platform & Environment
ENVIRONMENT=production
DEBUG=False
PORT=8000

# Security & Authentication
SECRET_KEY=generate-a-strong-jwt-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL / TimescaleDB)
POSTGRES_USER=cams_user
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=cams_db
DATABASE_URL=postgresql://cams_user:replace_with_secure_password@localhost:5432/cams_db

# Cache & Redis Queue
REDIS_URL=redis://localhost:6379/0

# Computer Vision & Models
YOLO_MODEL_PATH=yolov8n.pt
PRODUCT_MODEL_PATH=app/models/sku110k_best.pt
CONFIDENCE_THRESHOLD=0.15

# Cloud Provider (AWS / Azure)
CLOUD_PROVIDER=AWS
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=cams-retail-analytics-media-bucket

# Monitoring & Logging
LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGGING=True
