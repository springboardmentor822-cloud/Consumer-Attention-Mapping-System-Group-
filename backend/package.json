{
  "name": "attention-mapping-backend",
  "version": "1.0.0",
  "description": "Consumer Attention Mapping System Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:detection": "cd python_engine && ..\\venv\\Scripts\\python.exe -m uvicorn main:app --host 0.0.0.0 --port 8000 --log-level info",
    "dev:full": "concurrently --names \"NODE,PYTHON\" --prefix-colors \"cyan,green\" \"npm run dev\" \"npm run dev:detection\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.1",
    "morgan": "^1.10.0",
    "pg": "^8.11.2",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.32.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.14"
  }
}
