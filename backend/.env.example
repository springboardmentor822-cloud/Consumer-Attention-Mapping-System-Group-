# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored - never commit real credentials.

APP_NAME=Consumer Attention Mapping System
ENVIRONMENT=development

# Postgres connection. URL-encode special characters in the password
# (e.g. "@" becomes "%40").
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD_HERE@localhost:5432/consumer_attention_db

# Generate a strong random value for any non-local deployment, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo-only: simulates automatic employee attendance detections when no real
# face/badge identification system is connected yet. Must be false in production.
DEMO_ATTENDANCE=false
