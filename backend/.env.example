# Backend Service Configuration
PROJECT_NAME="Consumer Attention Mapping System"
DEBUG=false
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS="*"

# Database Connection
DATABASE_URL="postgresql://attention_user:attention_secure_pwd@localhost:5432/attention_db"

# Redis Cache and Stream Connection
REDIS_URL="redis://localhost:6379/0"

# Security and JWT Token details
JWT_SECRET="super_secret_attention_key_12345!"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Feature Flags
ENABLE_GAZE=true
ENABLE_RECOMMENDATIONS=true
ENABLE_NOTIFICATIONS=true
