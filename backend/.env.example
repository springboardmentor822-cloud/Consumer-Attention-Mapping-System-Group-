# --- General ---
ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql+psycopg2://attention_user:attention_pass@db:5432/attention_mapping

# --- Security ---
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google OAuth2 (optional, leave blank to disable) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Live Cameras panel (Store Manager dashboard) ---
# JSON file listing the 8 camera feeds (id, name, video source). Point a
# camera's "source" at a real rtsp://.../http(s):// URL or webcam index to
# use real hardware instead of the bundled sample footage - no code changes.
LIVE_CAMERAS_CONFIG_PATH=app/config/live_cameras.json
LIVE_CAMERA_RECONNECT_SECONDS=5
LIVE_CAMERA_STREAM_FPS=12
LIVE_CAMERA_DETECT_EVERY_N_FRAMES=3

# --- Email (optional, logs to console if left blank) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@attention-mapping.local

# --- Postgres container settings (used by docker-compose) ---
POSTGRES_USER=attention_user
POSTGRES_PASSWORD=attention_pass
POSTGRES_DB=attention_mapping
